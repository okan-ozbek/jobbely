{
  "name": "jobbely",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jobbely/backend --filter @jobbely/frontend dev",
    "build": "pnpm --filter @jobbely/backend build && pnpm contracts && pnpm --filter @jobbely/frontend build",
    "contracts": "pnpm --filter @jobbely/backend export:openapi && pnpm --filter @jobbely/frontend generate:api",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @jobbely/backend test",
    "check": "pnpm format:check && node scripts/check-boundaries.mjs && pnpm logos:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "logos:check": "node scripts/check-company-logos.mjs",
    "logos:fetch": "node scripts/fetch-company-logos.mjs",
    "lint": "eslint backend/src backend/prisma.config.ts frontend/src frontend/vite.config.ts scripts eslint.config.mjs --max-warnings 0",
    "lint:fix": "eslint backend/src backend/prisma.config.ts frontend/src frontend/vite.config.ts scripts eslint.config.mjs --fix",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "sync": "pnpm --filter @jobbely/backend sync",
    "sync:wave-a": "pnpm --filter @jobbely/backend run sync --wave A",
    "audit:wave-a": "pnpm --filter @jobbely/backend run audit --wave A",
    "db:generate": "pnpm --filter @jobbely/backend db:generate",
    "db:migrate": "pnpm --filter @jobbely/backend db:migrate",
    "sync:wave-b": "pnpm --filter @jobbely/backend run sync --wave B",
    "audit:wave-b": "pnpm --filter @jobbely/backend run audit --wave B",
    "sync:wave-c": "pnpm --filter @jobbely/backend run sync --wave C",
    "audit:wave-c": "pnpm --filter @jobbely/backend run audit --wave C",
    "sync:wave-d": "pnpm --filter @jobbely/backend run sync --wave D",
    "audit:wave-d": "pnpm --filter @jobbely/backend run audit --wave D"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
