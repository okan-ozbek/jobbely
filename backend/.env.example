# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Register exact callbacks at FRONTEND_ORIGIN/api/v1/auth/{github|linkedin}/callback.
