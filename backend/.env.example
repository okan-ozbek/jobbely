DATA_MODE=demo
DATABASE_URL=postgresql://jobbely:jobbely@127.0.0.1:5432/jobbely
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Set DATA_MODE=postgres for persisted real listings. Demo contains labeled synthetic examples.
# Optional: MATCH_CURSOR_SECRET must have 32+ random characters; share across API replicas.
# Optional account sign-in (requires PostgreSQL and the account migration).
# Keep all OAuth credentials backend-only. Leave unset to disable that provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Register exact callbacks at FRONTEND_ORIGIN/api/v1/auth/{github|linkedin}/callback.
# Email/password registration and reset require this shared, stable backend-only secret.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# AUTH_CODE_SECRET=
# The API enqueues encrypted emails; start the separate worker with pnpm worker:email.
# Set identical DATABASE_URL and AUTH_CODE_SECRET in API and email-worker processes.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=accounts@example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# STARTTLS is required unless SMTP_SECURE=true (implicit TLS, normally port 465).
# Local mail-capture only: SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_ALLOW_INSECURE_LOCAL=true.
