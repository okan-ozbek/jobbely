{
  "name": "@jobbely/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src prisma.config.ts --max-warnings 0",
    "lint:fix": "eslint src prisma.config.ts --fix",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "export:openapi": "tsx src/cli/export-openapi.ts",
    "sync": "tsx src/cli/sync.ts",
    "audit": "tsx src/cli/audit-source.ts",
    "worker": "tsx src/worker/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.41",
    "zod": "^4.1.12",
    "sanitize-html": "^2.17.0",
    "cheerio": "^1.1.2",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^7.0.0"
  }
}
