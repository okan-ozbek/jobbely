generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DatasetVersion {
  id Int @id
  version Int @default(0)
  featureGeneration Int @default(0)
}

model SourceLease {
  sourceId String @id
  runId String
  expiresAt DateTime
}

model CompanyCoverage {
  companySlug String @id
  checkedAt DateTime
  payload Json
}

model Run {
  id String @id
  sourceId String
  status String
  payload Json
  @@index([sourceId, status])
}

model Posting {
  id String @id
  sourceId String
  sourcePostingId String
  companySlug String
  category String
  status String
  title String
  contentHash String
  locations Json @default("[]")
  workplace String @default("unknown")
  lastSeenAt String @default("")
  payload Json
  versions PostingVersion[]
  features JobFeature?
  @@unique([sourceId, sourcePostingId])
  @@index([companySlug, category, status])
  @@index([status, category, sourceId, id])
}

model JobFeature {
  postingId String @id
  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  contentHash String
  version String
  category String
  skillIds String[]
  payload Json
  @@index([version, category, postingId])
}

model PostingVersion {
  id String @id @default(uuid())
  postingId String
  posting Posting @relation(fields: [postingId], references: [id])
  observedAt DateTime
  contentHash String
  payload Json
  @@index([postingId, observedAt])
}

model Snapshot {
  id String @id @default(uuid())
  runId String
  sourceId String
  url String
  fetchedAt DateTime
  payload Json
  @@index([sourceId, fetchedAt])
}

model AccountUser {
  id String @id @default(uuid())
  state String @default("active")
  email String?
  username String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identities AccountIdentity[]
  sessions ApplicationSession[]
  passwordCredential PasswordCredential?
}

model PasswordCredential {
  email String @id
  userId String @unique
  user AccountUser @relation(fields: [userId], references: [id])
  passwordHash String
  verifiedAt DateTime
  updatedAt DateTime @updatedAt
}

model EmailChallenge {
  tokenHash String @id
  browserHash String
  email String
  purpose String
  codeHash String
  passwordHash String?
  username String?
  userId String?
  previousEmail String?
  attempts Int @default(0)
  sends Int @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  consumedAt DateTime?
  @@index([email, purpose])
  @@index([expiresAt])
  @@index([userId])
}

model CredentialRateWindow {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AccountEmailJob {
  id String @id @default(uuid())
  challengeHash String
  codeHash String
  sealedEmail String?
  state String @default("queued")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  expiresAt DateTime
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  @@index([state, availableAt])
  @@index([challengeHash])
  @@index([expiresAt])
}

model AccountIdentity {
  id String @id @default(uuid())
  issuer String
  subject String
  provider String
  userId String
  user AccountUser @relation(fields: [userId], references: [id])
  @@unique([issuer, subject])
  @@index([userId])
}

model ApplicationSession {
  tokenHash String @id
  csrfToken String
  userId String
  user AccountUser @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  idleExpiresAt DateTime
  absoluteExpiresAt DateTime
  revokedAt DateTime?
  @@index([userId])
  @@index([absoluteExpiresAt])
}

model OAuthAttempt {
  stateHash String @id
  browserHash String
  provider String
  verifier String
  nonce String
  expiresAt DateTime
  @@index([expiresAt])
}
