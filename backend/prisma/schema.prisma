generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DatasetVersion {
  id Int @id
  version Int @default(0)
  featureGeneration Int @default(0)
}

model SourceLease {
  sourceId String @id
  runId String
  expiresAt DateTime
}

model Run {
  id String @id
  sourceId String
  status String
  payload Json
  @@index([sourceId, status])
}

model Posting {
  id String @id
  sourceId String
  sourcePostingId String
  companySlug String
  category String
  status String
  title String
  contentHash String
  payload Json
  versions PostingVersion[]
  features JobFeature?
  @@unique([sourceId, sourcePostingId])
  @@index([companySlug, category, status])
  @@index([status, category, sourceId, id])
}

model JobFeature {
  postingId String @id
  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  contentHash String
  version String
  category String
  skillIds String[]
  payload Json
  @@index([version, category, postingId])
}

model PostingVersion {
  id String @id @default(uuid())
  postingId String
  posting Posting @relation(fields: [postingId], references: [id])
  observedAt DateTime
  contentHash String
  payload Json
  @@index([postingId, observedAt])
}

model Snapshot {
  id String @id @default(uuid())
  runId String
  sourceId String
  url String
  fetchedAt DateTime
  payload Json
  @@index([sourceId, fetchedAt])
}
