{
  "name": "@jobbely/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner src/features/resume",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "lint:fix": "eslint src vite.config.ts --fix",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.15.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
